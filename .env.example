# 搬💩 v0.1 · 复制为 .env 后使用；所有键由 AppConfig 统一解析。
# 开发默认值。生产环境必须关闭 DEMO_ENABLED / SEED_DEMO 并更换密钥。

# SYSTEM
RAILS_ENV=development
PORT=3000
RAILS_MAX_THREADS=5
SECRET_KEY_BASE=development-only-change-this-secret-before-deploying-development-only-change-this-secret-before-deploying-
ALLOWED_HOSTS='[]'
FORCE_SSL=false
PAGE_SIZE=18
TIME_ZONE=Asia/Shanghai

# DATABASE
DATABASE_URL=postgresql://localhost/banshi_development
TEST_DATABASE_URL=postgresql://localhost/banshi_test
DATABASE_POOL=12
DATABASE_PREPARED_STATEMENTS=true
TEST_MAINTAIN_SCHEMA=true

# CANDIDATE
CANDIDATE_TTL_MINUTES=30
CANDIDATE_REPLY_WEIGHT=2
CANDIDATE_QUOTE_WEIGHT=2.5
CANDIDATE_REACTION_WEIGHT=1.5
CANDIDATE_REPEAT_WEIGHT=5
CANDIDATE_FORWARD_BASE_SCORE=1
CANDIDATE_IMAGE_BASE_SCORE=0
CANDIDATE_MIN_SCORE=5
CANDIDATE_MIN_UNIQUE_USERS=2
CANDIDATE_ACTIVITY_WEIGHT=0
CANDIDATE_MAX_LATE_MINUTES=1440

# REPUTATION
REPUTATION_ENABLED=true
REPUTATION_MIN_SAMPLES=5
REPUTATION_PRIOR_SUCCESSES=3
REPUTATION_PRIOR_FAILURES=3
REPUTATION_MAX_ADJUSTMENT=1
REPUTATION_NATURAL_WEIGHT=0.3
REPUTATION_CLASSIC_WEIGHT=1

# DUPLICATE
DUPLICATE_PHASH_THRESHOLD=5
DUPLICATE_POSSIBLE_THRESHOLD=12
DUPLICATE_ASPECT_TOLERANCE=0.12
DUPLICATE_SCAN_LIMIT=2000

# SAFETY
SAFETY_DEFAULT_LEVEL=RED
SAFETY_DEFAULT_VISIBILITY=hidden
SAFETY_TAGS='["GORE","NSFW","GROTESQUE","HARASSMENT","PRIVACY","EXTREME","OTHER_SENSITIVE"]'
SAFETY_HARD_BLOCK_TAGS='["PRIVACY","EXTREME"]'
SAFETY_FILE_BLACKLIST='[]'
SAFETY_SOURCE_BLACKLIST='[]'
REPORT_AUTO_PAUSE_THRESHOLD=3
REPORT_URGENT_REASONS='["privacy","minors"]'

# TRIAL
TRIAL_ENABLED=true
TRIAL_GROUP_MIN=3
TRIAL_GROUP_MAX=5
TRIAL_DURATION_MINUTES=60
TRIAL_REACTION_GOOD=💩
TRIAL_REACTION_FUNNY=😂
TRIAL_REACTION_BAD=🥱
TRIAL_MIN_RESPONSIVE_GROUPS=1
TRIAL_POSITIVE_THRESHOLD=0.5
TRIAL_NEGATIVE_MAX=0.4
TRIAL_REPLY_POSITIVE_MIN=2
TRIAL_GOOD_WEIGHT=2
TRIAL_FUNNY_WEIGHT=1
TRIAL_BAD_WEIGHT=2
TRIAL_MAX_WAIT_HOURS=24

# DISTRIBUTION
DISTRIBUTION_ENABLED=true
DISTRIBUTION_GROUP_DAILY_LIMIT=6
DISTRIBUTION_GROUP_COOLDOWN_MINUTES=60
DISTRIBUTION_GLOBAL_PER_MINUTE=20
DISTRIBUTION_BATCH_SIZE=3
DISTRIBUTION_REPEAT_AFTER_DAYS=90
HOT_SCORE_THRESHOLD=18
HOT_MIN_NATURAL_OCCURRENCES=5
HOT_WINDOW_DAYS=7

# CLASSIC
CLASSIC_MIN_NATURAL_OCCURRENCES=8
CLASSIC_MIN_NATURAL_GROUPS=3
CLASSIC_MIN_LIFESPAN_DAYS=90
CLASSIC_MIN_REVIVALS=1
REVIVAL_GAP_DAYS=30

# CLAIM
CLAIM_TTL_MINUTES=10
CLAIM_MAX_ATTEMPTS=6
CLAIM_TOKEN_LENGTH=8

# LEADERBOARD
LEADERBOARD_PERIOD_DAYS=7
LEADERBOARD_LIMIT=20

# NAPCAT
NAPCAT_ENABLED=false
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_HTTP_URL=http://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=
NAPCAT_WEBHOOK_TOKEN=
NAPCAT_REQUEST_TIMEOUT_SECONDS=10
NAPCAT_REACTION_MAP='{"128169":"💩","128514":"😂","129393":"🥱"}'
NAPCAT_MEDIA_ALLOWED_HOSTS='["multimedia.nt.qq.com","gchat.qpic.cn","c2cpicdw.qpic.cn"]'
NAPCAT_MAX_MEDIA_BYTES=20000000
RAW_EVENT_RETENTION_DAYS=14
NAPCAT_RECONNECT_SECONDS=5
NAPCAT_MAX_FORWARD_DEPTH=5
NAPCAT_MAX_FORWARD_NODES=200
NAPCAT_MAX_FORWARD_MEDIA=50
NAPCAT_MAX_MEDIA_PIXELS=40000000
NAPCAT_CONNECTION_TOKENS='{}'

# STORAGE
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=storage/media
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# FEATURES
FEATURE_TRIAL=true
FEATURE_REPUTATION=true
FEATURE_PHASH=true
FEATURE_PUBLIC_GROUPS=true
FEATURE_WEB_RATING=true
FEATURE_AUTO_CLASSIC=true
FEATURE_GROUP_TASTE_PROFILE=true

# DEMO
DEMO_ENABLED=true
SEED_DEMO=true
DEMO_EMAIL=curator@example.test
DEMO_PASSWORD=Museum-demo-2026!

# JOBS
JOB_THREADS=5
JOB_POLL_INTERVAL=5
JOB_CRON_ENABLED=true
JOB_MAINTENANCE_CRON="* * * * *"
JOB_STATISTICS_CRON="*/15 * * * *"
JOB_RETRY_ATTEMPTS=5

# MODES
BOT_MODE_RULES='{"搬💩":{"collect":true,"distribute":false},"吃💩":{"collect":false,"distribute":true},"自助餐":{"collect":true,"distribute":true}}'

# SECURITY
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
CLAIM_RATE_LIMIT=10
AUTH_RATE_PERIOD_SECONDS=60
SIGNUP_RATE_PERIOD_SECONDS=300

