<% content_for :title,'搬运员名录' %><section class="opening"><div><h1>下水道，总有人在勘探</h1><p>他们没有投稿，只是在群里顺手发了一条。</p></div><span class="mono"><%= @total %> 位公开搬运者</span></section><div class="transporter-grid"><% @transporters.each_with_index do |person,i| %><a class="transporter-card" href="<%= transporter_path(person) %>"><div class="transporter-top"><span class="person-initial"><%= person.display_name.first %></span><span class="mono muted">NO.<%= format('%03d',(@page-1)*24+i+1) %></span></div><h2><%= person.display_name %></h2><span class="transporter-title"><%= person.title %></span><div class="transporter-stats"><span><b><%= person.natural_count %></b>自然搬运</span><span><b><%= person.accepted_count %></b>成功建档</span><span><b><%= person.classic_count %></b>典藏发现</span></div><p>信誉 <%= rate(person.reputation_score) %> · <%= person.candidate_count %> 份候选样本</p></a><% end %></div><%= render 'shared/pagination',total:@total,page:@page,size:24 %>
