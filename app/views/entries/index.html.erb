<% content_for :title, '馆藏目录' %>
<section class="opening"><div><h1><%= EntryQuery::SORTS.fetch(params[:sort],'馆藏目录') %><span class="red-square"></span></h1><p>每件藏品都有一个编号，也有一段传播史。</p></div><span class="catalog-count mono"><%= @total %><small>件公开馆藏</small></span></section>
<%= form_with url:entries_path,method: :get,class:'catalog-search' do |f| %><%= f.search_field :q,value:params[:q],placeholder:'搜索 S-ID、标题、群馆、搬运者、标签…',aria:{label:'搜索馆藏'} %><%= f.submit '查档案',class:'button' %><% end %>
<nav class="browse-tabs"><% EntryQuery::SORTS.each do |key,label| %><%= link_to label,entries_path(request.query_parameters.merge(sort:key,page:nil)),class:params[:sort].to_s==key || (params[:sort].blank? && key=='latest') ? 'selected' : nil %><% end %></nav>
<%= form_with url:entries_path,method: :get,class:'filter-row' do |f| %><%= f.hidden_field :sort,value:params[:sort] %><%= f.hidden_field :q,value:params[:q] %><label>群馆<%= f.select :group,options_for_select([['全部群馆','']]+@groups.map { |g|[g.display_name,g.slug] },params[:group]) %></label><label>标签<%= f.select :tag,options_for_select([['全部标签','']]+AppConfig.safety.tags.map { |t|[tag_name(t),t] },params[:tag]) %></label><label>安全范围<%= f.select :safety,options_for_select([['全部可展出',''],['常规 GREEN','GREEN'],['敏感 YELLOW','YELLOW']],params[:safety]) %></label><label>从<%= f.date_field :from,value:params[:from] %></label><label>到<%= f.date_field :to,value:params[:to] %></label><%= f.submit '筛选',class:'button button-ghost' %><%= link_to '重置',entries_path,class:'muted' %><% end %>
<div class="shelf-grid"><%= render partial:'shared/entry_card',collection:@entries,as: :entry %></div><%= empty_state('没有匹配的公开馆藏，试试其他关键词。') if @entries.empty? %><%= render 'shared/pagination',total:@total,page:@page %>
