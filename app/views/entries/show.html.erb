<% content_for :title, "#{@entry.sid} #{@entry.display_title}" %>
<div class="breadcrumbs"><%= link_to '馆藏目录',entries_path %><span>/</span><span><%= @entry.sid %></span></div>
<section class="entry-heading"><div class="accession-large mono"><%= @entry.sid %></div><div class="entry-heading-labels"><%= level_badge(@entry) %><%= safety_badge(@entry) %></div><h1><%= @entry.display_title %></h1><% if @entry.summary.present? %><p><%= @entry.summary %></p><% end %></section>
<div class="entry-layout"><section class="original-content"><% if @entry.safety_level=='YELLOW' %><div class="sensitive-note">含敏感标记：<%= @entry.safety_tags.map { |t|tag_name(t) }.join('、') %>。可选择跳过这件藏品。</div><% end %>
<% if @entry.content.forward? %><div class="forward-full"><div class="forward-title">一份被留下来的群聊记录<span><%= @entry.content.forward_nodes.size %> 段</span></div><%= render 'shared/forward_nodes',nodes:Media::ForwardStructure.tree(@entry.content),content:@entry.content %></div><% end %>
<% (@entry.content.forward? ? [] : @entry.content.assets).each do |asset| %><% if asset.visibility=='visible' %><figure class="original-image"><%= image_tag media_path(asset),alt:@entry.display_title,width:asset.width,height:asset.height %><figcaption>原始附件 · <%= asset.width %> × <%= asset.height %></figcaption></figure><% else %><%= empty_state('此资源已下架，仅保留元数据。') %><% end %><% end %>
<% if current_user&.curator? %><%= link_to "编辑标题 / 安全档案",curation_path(q:@entry.sid),class:"button button-ghost" %><% end %><div class="entry-actions"><% if AppConfig.features.web_rating %><% WebRating::REACTIONS.each do |reaction| %><%= button_to "#{reaction} #{@ratings.fetch(reaction,0)}",rate_entry_path(@entry),params:{reaction:reaction},class:"reaction-button #{@my_ratings.include?(reaction) ? 'selected' : ''}",aria:{label:"评价 #{reaction}",pressed:@my_ratings.include?(reaction)} %><% end %><% end %><%= button_to '☆ 收藏',favorite_entry_path(@entry),class:'button button-ghost' %><%= link_to '举报 / 申请处理',new_entry_report_path(@entry),class:'report-link' %></div><p class="small muted">网站评价是观众的娱乐反馈，不替代试吃记录和安全审核。</p>
</section><aside class="archive-facts"><h2>藏品档案</h2><dl><div><dt>首次发现</dt><dd><%= museum_time(@entry.first_seen_at) %></dd></div><div><dt>首次出土群</dt><dd><%= group_link(@entry.first_group) %></dd></div><div><dt>第一位搬运者</dt><dd><%= transporter_link(@entry.first_transporter,group:@entry.first_group) %></dd></div><div><dt>最近自然出现</dt><dd><%= museum_date(@entry.last_natural_at) %></dd></div><div><dt>安全标签</dt><dd><%= @entry.safety_tags.any? ? @entry.safety_tags.map { |t|tag_name(t) }.join(' / ') : '无敏感标签' %></dd></div></dl><div class="facts-numbers"><div><b><%= @entry.natural_count %></b><span>自然搬运</span></div><div><b><%= @entry.bot_count %></b><span>机器人投放</span></div><div><b><%= @entry.natural_group_count %></b><span>自然出土群</span></div><div><b><%= @entry.interaction_count %></b><span>独立互动用户</span></div><div><b><%= @entry.lifespan_days %><small>天</small></b><span>生命跨度</span></div><div><b><%= @entry.revival_count %></b><span>沉寂后复活</span></div></div><div class="facts-footnote">自然搬运只统计群友主动发出的内容。机器人传播不会增加自然搬运计数。</div><% if @trial %><%= link_to '查看完整试吃记录 →',trial_path(@trial),class:'button button-ghost full-width' if @entry.public? %><% end %></aside></div>
<nav class="anchor-nav"><a href="#history">传播时间线</a><a href="#trial">试吃档案</a><a href="#groups">出土分布</a><a href="#related">相关馆藏</a></nav>
<div class="detail-lower"><section id="history"><div class="section-heading"><h2>它是怎么传到这里的</h2><span class="mono"><%= @timeline.size %> 条记录</span></div><%= render 'shared/timeline',events:@timeline %></section><div><section id="trial" class="detail-panel"><h2>试吃档案</h2><% if @trial&.trial_result %><%= render 'trials/result',result:@trial.trial_result %><% elsif @trial %><p>正在等待这一轮试吃结束。</p><% else %><%= empty_state('尚未进行抢先试吃。') %><% end %></section><section id="groups" class="detail-panel"><h2>在哪些群出土过</h2><% @occurrences.group_by(&:group).each do |group,occurrences| %><% next unless group.public_archive? %><div class="distribution-row"><%= group_link(group) %><span><%= occurrences.count { |o|o.source=='NATURAL' } %> 自然 / <%= occurrences.count { |o|o.source!='NATURAL' } %> 投放</span></div><% end %></section><% if @matches.any? %><section class="detail-panel"><h2>可能见过它的亲戚</h2><% @matches.each do |match| %><p><%= link_to match.shit_entry.sid,entry_path(match.shit_entry) %> · 相似度 <%= rate(match.confidence) %>，尚未确认合并</p><% end %></section><% end %></div></div>
<section id="related" class="section"><div class="section-heading"><h2>同一座群馆，还出土过</h2></div><div class="shelf-grid"><%= render partial:'shared/entry_card',collection:@related,as: :entry %></div></section>
