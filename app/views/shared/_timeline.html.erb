<ol class="timeline"><% events.each do |event| %><li><span class="timeline-node <%= event.event_type.to_s.include?('reviv') ? 'revived' : '' %>"></span><time><%= museum_time(event.occurred_at) %></time><div class="timeline-body"><strong><%= event.label %></strong><% if event.group&.public_archive? %><span><%= group_link(event.group) %></span><% end %><% if local_assigns[:show_entry] && event.shit_entry&.public? %><%= link_to "#{event.shit_entry.sid} · #{event.shit_entry.display_title}",entry_path(event.shit_entry),class:'timeline-entry' %><% end %><% if event.details['reason'].present? %><p><%= event.details['reason'] %></p><% end %></div></li><% end %></ol>
<%= empty_state('时间线正在等待第一次出土。') if events.empty? %>
