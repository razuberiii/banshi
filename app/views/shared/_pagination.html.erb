<% pages=page_count(total,local_assigns.fetch(:size,AppConfig.system.page_size)); if pages>1 %><nav class="pagination" aria-label="分页"><%= link_to '← 上一页',url_for(request.query_parameters.merge(page:page-1)),class:'button button-ghost' if page>1 %><span class="mono">第 <%= page %> / <%= pages %> 页 · <%= total %> 件</span><%= link_to '下一页 →',url_for(request.query_parameters.merge(page:page+1)),class:'button button-ghost' if page<pages %></nav><% end %>
