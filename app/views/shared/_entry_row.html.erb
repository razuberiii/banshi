<div class="entry-row"><span class="row-rank"><%= local_assigns[:rank] ? format('%02d',rank) : '↳' %></span><div><a class="mono small" href="<%= entry_path(entry) %>"><%= entry.sid %></a><h3><%= link_to entry.display_title,entry_path(entry) %></h3><span class="muted small"><%= safe_group_name(entry.first_group) %> · <%= local_assigns[:metric] || "#{entry.natural_count} 次自然搬运" %></span></div><%= level_badge(entry) %></div>
