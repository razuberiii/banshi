<% content_for :title,'试吃档案' %><div class="breadcrumbs"><%= link_to '抢先试吃',trials_path %><span>/</span><%= link_to @entry.sid,entry_path(@entry) %></div><section class="opening"><div><h1><%= @entry.display_title %></h1><p>这一轮试吃，从 <%= museum_time(@run.started_at) %> 到 <%= museum_time(@run.ends_at) %></p></div><%= level_badge(@entry) %></section><div class="trial-detail-layout"><section class="detail-panel"><h2>本轮总计</h2><% if @run.trial_result %><%= render 'result',result:@run.trial_result %><% else %><div class="awaiting-feedback">观察中<small>沉默暂记为未知。</small></div><% end %></section><section><h2>每个试吃席位</h2><% @seats.each do |seat| %><div class="trial-seat"><span class="group-sigil"><%= safe_group_name(seat.group).first %></span><div><h3><%= group_link(seat.group) %></h3><p><%= {'unknown'=>'暂时没有明确反馈','positive'=>'有正向反馈','negative'=>'有明确负向反馈','mixed'=>'正负反馈都有'}.fetch(seat.feedback_state,seat.feedback_state) %></p><small>投放状态：<%= seat.delivery.status %></small></div></div><% end %><%= empty_state('等待符合胃口与安全条件的空席。') if @seats.empty? %></section></div><%= link_to '回到这件藏品的传播史 →',entry_path(@entry),class:'button button-ghost' %>
