<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title><%= content_for?(:title) ? "#{yield(:title)} · Banshi" : 'Banshi · Internet culture archive' %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Banshi 连接群聊，记录内容的发现、传播与自然再次出现。">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag 'application', 'data-turbo-track':'reload' %>
  <%= javascript_include_tag 'application', defer:true %>
</head>
<body>
<a class="skip-link" href="#main">跳到馆藏内容</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="<%= root_path %>" aria-label="Banshi，返回首页"><span class="brand-word">Banshi<small>Network & Archive</small></span></a>
    <nav aria-label="主导航" class="primary-nav">
      <%= link_to 'Network',root_path,class:controller_name=='home' ? 'active' : nil %>
      <%= link_to 'Archive',entries_path,class:controller_name=='entries' ? 'active' : nil %>
      <%= link_to 'Groups',groups_path if AppConfig.features.public_groups %>
      <%= link_to 'Timeline',timeline_path %>
      <%= link_to 'Explore',rankings_path %>
    </nav>
    <div class="header-actions">
      <%= link_to '⌕',search_path,class:'search-link',aria:{label:'搜索馆藏'} %>
      <% if signed_in? %><%= link_to current_user.display_name,profile_path(current_user),class:'visitor-link' %>
      <% else %><%= link_to '登录',login_path,class:'button button-small' %><% end %>
    </div>
  </div>
</header>
<% if flash.any? %><div class="flash-stack" role="status"><% flash.each do |type,message| %><div class="flash <%= type %>"><%= message %></div><% end %></div><% end %>
<main id="main" class="site-main"><%= yield %></main>
<footer class="site-footer"><div class="footer-inner"><div><b>Banshi</b><p>内容的生命史，来自真实的再次出现。</p></div><div class="footer-links"><%= link_to '搬运员名录',transporters_path %><%= link_to '传播时间线',timeline_path %><%= link_to '认领群馆',claims_path %><%= link_to '模拟 QQ 实验室',demo_path if AppConfig.demo.enabled %><%= link_to 'System',system_status_path if current_user&.curator? %></div><span class="edition">Banshi Network / v0.1<br>不以沉默为差评</span></div></footer>
</body></html>
