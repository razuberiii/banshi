<section class="network-opening">
  <p class="eyebrow">Banshi Network <span>Internet culture, in circulation.</span></p>
  <h1>内容流动，<br><span>轨迹留下。</span></h1>
  <div class="network-intro"><p>一个连接 QQ 群的内容发现与传播网络。<br>记录首次发现、跨群传播，以及每一次自然再次出现。</p><%= link_to '浏览 Archive ↗',entries_path,class:'text-link' %></div>
</section>
<div class="museum-strip"><span><b class="mono"><%= short_number(@counts[:entries]) %></b> Archives</span><span><b class="mono"><%= @counts[:groups] %></b> Groups</span><span><b class="mono"><%= short_number(@counts[:natural]) %></b> Natural occurrences</span><span class="strip-note mono"><%= Time.current.strftime('%Y.%m.%d / %H:%M') %></span></div>
<section class="section"><div class="section-heading"><div><p class="eyebrow">01 / In circulation</p><h2>正在传播</h2></div><%= link_to '传播时间线 ↗',timeline_path %></div>
<div class="shelf-grid"><%= render partial:'shared/entry_card',collection:@active,as: :entry %></div>
<%= empty_state('尚无活跃传播记录。内容被发现并传播后，轨迹会出现在这里。') if @active.empty? %></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">02 / Recently observed</p><h2>最近发现</h2></div><%= link_to '所有档案 ↗',entries_path %></div><div class="shelf-grid"><%= render partial:'shared/entry_card',collection:@fresh,as: :entry %></div><%= empty_state('等待网络中的首次发现。') if @fresh.empty? %></section>
<div class="editorial-columns section"><section><div class="section-heading"><div><p class="eyebrow">03 / Natural recurrence</p><h2>自然再次出现</h2></div></div><% @natural.each do |entry| %><%= render 'shared/entry_row',entry:entry,metric:"#{entry.natural_count} 次自然出现" %><% end %><%= empty_state('自然复读会延长内容的生命史。') if @natural.empty? %></section>
<section><div class="section-heading"><div><p class="eyebrow">04 / Rediscovered</p><h2>最近复活</h2></div></div><% @revivals.each do |entry| %><%= render 'shared/entry_row',entry:entry,metric:"#{entry.revival_count} 次复活" %><% end %><%= empty_state('等待一份旧档案重新回到群聊。') if @revivals.empty? %></section></div>
<% if @trials.any? %><section class="section"><div class="section-heading"><div><p class="eyebrow">Early / Optional trial</p><h2>提前观察</h2></div><%= link_to 'Trials ↗',trials_path %></div><% @trials.each do |run| %><a class="trial-live-row" href="<%= trial_path(run) %>"><span class="mono"><%= run.shit_entry.sid %></span><h3><%= run.shit_entry.display_title %></h3><span><%= run.trial_deliveries.count %> groups</span></a><% end %></section><% end %>
