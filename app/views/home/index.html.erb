<section class="opening"><div><h1>今日新鲜出土<span class="red-square"></span></h1><p>群聊里顺手一发，馆里认真存一份。</p></div><%= link_to '随机吃一口 ↗',random_path,class:'button button-dark random-button' %></section>
<div class="museum-strip"><span><b class="mono"><%= short_number(@counts[:entries]) %></b> 件公开馆藏</span><span><b class="mono"><%= @counts[:groups] %></b> 座群馆</span><span><b class="mono"><%= short_number(@counts[:natural]) %></b> 次自然搬运</span><span class="strip-note">今日开馆 · <%= Date.current.strftime('%Y.%m.%d') %></span></div>
<nav class="browse-tabs" aria-label="馆藏快捷入口"><%= link_to '全部出土',entries_path,class:'selected' %><%= link_to '正在热门',hot_path %><%= link_to '自然复读',entries_path(sort:'natural') %><%= link_to '最近复活',revivals_path %><%= link_to '陈年老屎',classics_path %><%= link_to '搜索馆藏 ↗',search_path,class:'push-right' %></nav>
<div class="shelf-grid"><%= render partial:'shared/entry_card',collection:@fresh,as: :entry %></div>
<%= empty_state if @fresh.empty? %>
<div class="section-end"><%= link_to '继续翻馆藏 →',entries_path,class:'text-link' %></div>
<section class="trial-band"><div class="trial-intro"><span class="trial-stamp">抢先<br>试吃</span><h2>这口屎，<br>正在试吃。</h2><p>小范围上桌，反馈自愿。<br>没有表情，只代表未知。</p><%= link_to '进入试吃间 →',trials_path,class:'text-link' %></div><div class="trial-live"><% @trials.each do |run| %><a class="trial-live-row" href="<%= trial_path(run) %>"><span class="mono"><%= run.shit_entry.sid %></span><h3><%= run.shit_entry.display_title %></h3><span><%= run.trial_deliveries.count %> 个群试吃 · 截止 <%= run.ends_at&.strftime('%H:%M') %></span><b>观察中 ↗</b></a><% end %><%= empty_state('暂时没有进行中的试吃。') if @trials.empty? %><div class="reaction-key"><span>💩 好屎</span><span>😂 有节目效果</span><span>🥱 有点水</span><span>沉默 ≠ 差评</span></div></div></section>
<section class="section"><div class="section-heading"><h2>本周，传得有点快</h2><%= link_to '查看排行榜 ↗',rankings_path %></div><div class="rank-columns"><div class="rank-panel"><h3 class="panel-title">跨群传播最快</h3><% @fastest.each_with_index do |entry,i| %><%= render 'shared/entry_row',entry:entry,rank:i+1 %><% end %></div><div class="rank-panel"><h3 class="panel-title">群友主动搬得最多</h3><% @natural.each_with_index do |entry,i| %><%= render 'shared/entry_row',entry:entry,rank:i+1 %><% end %></div></div></section>
<section class="section"><div class="section-heading"><h2>死去的记忆，又开始攻击我</h2><%= link_to '最近复活 ↗',revivals_path %></div><div class="revival-grid"><% @revivals.each do |entry| %><a href="<%= entry_path(entry) %>" class="revival-card"><span class="mono"><%= entry.sid %></span><div class="revival-age mono"><%= entry.lifespan_days %><small>天</small></div><h3><%= entry.display_title %></h3><p><%= entry.revival_count %> 次复活 · 最近出土 <%= museum_date(entry.last_natural_at) %></p><span class="red-text">又被自然搬了出来 ↗</span></a><% end %></div></section>
<section class="section"><div class="section-heading"><h2>陈年老屎，历久弥新</h2><%= link_to '进入典藏室 ↗',classics_path %></div><div class="shelf-grid shelf-four"><%= render partial:'shared/entry_card',collection:@classic,as: :entry %></div></section>
<div class="editorial-columns section"><section><div class="section-heading"><h2>今日考古</h2></div><% if @archaeology %><a class="archaeology-pick" href="<%= entry_path(@archaeology) %>"><span class="big-year mono"><%= @archaeology.first_seen_at.year %></span><div><span class="mono"><%= @archaeology.sid %></span><h3><%= @archaeology.display_title %></h3><p><%= @archaeology.natural_count %> 次自然出现，<%= @archaeology.lifespan_days %> 天生命史。</p><span>打开这一页旧档案 →</span></div></a><% else %><%= empty_state %><% end %></section><section><div class="section-heading"><h2>今日试吃结果</h2></div><% @results.each do |result| %><div class="result-row"><div><%= link_to result.trial_run.shit_entry.display_title,trial_path(result.trial_run) %><small><%= trial_verdict(result) %> · <%= result.responsive_group_count %>/<%= result.trial_group_count %> 群有反馈</small></div><span class="mono"><%= rate(result.positive_rate) %></span></div><% end %></section></div>
<section class="section"><div class="section-heading"><h2>最近开门的群馆</h2><%= link_to '所有群馆 ↗',groups_path if AppConfig.features.public_groups %></div><div class="group-grid"><% @groups.each do |group| %><%= render 'groups/card',group:group %><% end %></div></section>
<div class="editorial-columns section"><section><div class="section-heading"><h2>新晋典藏</h2></div><% @new_classics.each do |entry| %><%= render 'shared/entry_row',entry:entry %><% end %></section><section><div class="section-heading"><h2>本周搬屎王</h2><%= link_to '搬运员名录 ↗',transporters_path %></div><% @leaders.each_with_index do |person,i| %><div class="person-row"><span class="row-rank"><%= format('%02d',i+1) %></span><div><%= link_to person.display_name,transporter_path(person) %><small><%= person.title %> · <%= person.candidate_count %> 份样本</small></div><b class="mono"><%= person.accepted_count %></b></div><% end %></section></div>
