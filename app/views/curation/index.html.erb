<% content_for :title,'馆务' %><section class="opening"><div><h1>馆务工作台</h1><p>审核、处理举报、修正归档。每一步都会留下审计记录。</p></div><%= link_to '返回公开馆藏',entries_path,class:'button button-ghost' %></section><section class="section"><%= form_with url:curation_path,method: :get,class:"curation-fields" do |f| %><label>打开任意藏品的安全档案<%= f.text_field :q,value:params[:q],placeholder:"S-000001" %></label><%= f.submit "按 S-ID 查找",class:"button button-ghost" %><% end %><h2>藏品安全审核</h2><% @entries.each do |entry| %><article class="curation-item"><h2><%= link_to "#{entry.sid} · #{entry.display_title}",entry_path(entry) %></h2><p class="small muted">未审核内容不会因为热度高而自动解锁。</p><%= form_with url:review_entry_path(entry),class:'curation-fields' do |f| %><label>馆藏标题（可留空）<%= f.text_field :title,value:entry.title,maxlength:120 %></label><label>馆藏说明<%= f.text_area :summary,value:entry.summary,maxlength:2000 %></label><label>安全级别<%= f.select :level,%w[RED YELLOW GREEN],selected:entry.safety_level %></label><label>网站可见性<%= f.select :visibility,[['隐藏','hidden'],['仅元数据','metadata_only'],['允许公开','public']],selected:entry.visibility %></label><label>安全标签<%= f.select :tags,AppConfig.safety.tags.map { |key|[tag_name(key),key] },{selected:entry.safety_tags},{multiple:true} %></label><label>判定依据<%= f.text_field :reason,required:true,placeholder:'请写清审核依据' %></label><%= f.submit '记录安全判定',class:'button' %><% end %><%= render "curation/resume",entry:entry %><% entry.content.assets.each do |asset| %><div class="entry-actions"><span class="small muted">附件 #<%= asset.id %> · <%= asset.visibility %></span><%= button_to '下架资源',hide_asset_path(asset),class:'button button-ghost' %><%= form_with url:redact_asset_path(asset),multipart:true,class:'curation-fields' do |f| %><label>上传打码替代图<%= f.file_field :replacement,accept:'image/png,image/jpeg,image/webp',required:true %></label><%= f.submit '替换资源',class:'button button-ghost' %><% end %></div><% end %><details class="debug-details"><summary>确认重复，合并至另一永久编号</summary><%= form_with url:merge_entry_path(entry),class:'curation-fields' do |f| %><label>目标 S-ID<%= f.text_field :target_sid,placeholder:'S-000001',required:true %></label><label>合并原因<%= f.text_field :reason,required:true %></label><%= f.submit '合并并保留原编号',class:'button button-ghost' %><% end %></details></article><% end %><%= empty_state('没有等待审核的条目。') if @entries.empty? %></section><section class="section"><h2>待处理举报</h2><% @reports.each do |report| %><article class="curation-item"><h3><%= report.shit_entry.sid %> · <%= Report::REASONS[report.reason] %></h3><p><%= report.details %></p><%= form_with url:resolve_report_path(report),class:'curation-fields' do |f| %><label>处理结果<%= f.select :status,[['已处理','resolved'],['驳回','dismissed']] %></label><label>给举报人的回执<%= f.text_field :resolution,required:true %></label><%= f.submit '记录处理结果',class:'button' %><% end %></article><% end %><%= empty_state('当前没有未处理举报。') if @reports.empty? %></section><section class="section"><h2>可能已发出的投放</h2><p class="muted small">发送结果不明确时，系统不会盲目重发。请先到 NapCat 核实消息。</p><% @uncertain.each do |delivery| %><div class="result-row"><span><%= delivery.shit_entry.sid %> · <%= safe_group_name(delivery.group) %></span><span><%= delivery.error_message %></span></div><% end %></section><section class="section"><h2>合并审计</h2><% @merges.each do |merge| %><div class="result-row"><span><%= merge.source.sid %> → <%= merge.target.sid %> · <%= merge.reason %></span><% if merge.reverted_at %><span>已撤销</span><% else %><%= button_to '撤销错误合并',revert_merge_path(merge),class:'button button-ghost' %><% end %></div><% end %></section><section class="section"><h2>最近的异常记录</h2><% @errors.each do |error| %><details class="debug-details"><summary><%= museum_time(error.created_at) %> · <%= error.context %> / <%= error.error_class %></summary><pre><%= error.message %></pre></details><% end %><%= empty_state('最近没有异常记录。') if @errors.empty? %></section>

<section class="section"><h2>观察中的候选</h2><p class="muted">普通候选安静等待窗口结束。发现明确问题时，馆务可手动拒绝或隔离资源。</p><% @candidates.each do |candidate| %><article class="curation-item"><h3>Candidate #<%= candidate.id %> · <%= safe_group_name(candidate.group) %></h3><%= form_with url:moderate_candidate_path(candidate),class:'curation-fields' do |f| %><label>处理<%= f.select :status,[['不建档','rejected'],['安全隔离','unsafe']] %></label><label>明确依据<%= f.text_field :reason,required:true %></label><%= f.submit '记录候选处理',class:'button button-ghost' %><% end %></article><% end %></section>
