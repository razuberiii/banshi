<% content_for :title,@group.display_name %><div class="breadcrumbs"><%= link_to '群馆名录',groups_path %><span>/</span><span>群聊文化档案</span></div><section class="group-heading"><span class="group-sigil large"><%= @group.display_name.first %></span><div><h1><%= @group.display_name %></h1><p><%= @group.description %></p><span class="small muted"><%= museum_date(@group.joined_at) %> 加入网络 · <%= @group.anonymous? ? '匿名展馆' : '公开展馆' %> · 群号不公开</span></div><%= link_to '管理本群 ↗',edit_group_path(@group),class:'button button-ghost' if current_user&.manages?(@group) %></section><div class="metric-strip"><div><b><%= @stats.fetch('discoveries',@group.discovered_entries.count) %></b><span>有效出土</span></div><div><b><%= @stats.fetch('natural_occurrences',@group.shit_occurrences.natural.count) %></b><span>自然搬运</span></div><div><b><%= @group.shit_occurrences.bot.select(:shit_entry_id).distinct.count %></b><span>吃过的内容</span></div><div><b><%= @group.trial_deliveries.count %></b><span>试吃席位</span></div><div><b><%= rate(@stats.fetch('responsive_trials',0).to_f / [@group.trial_deliveries.count,1].max) %></b><span>试吃反馈率</span></div></div>
<% if @recent %><% if @representative %><section class="group-masterpiece"><span class="collection-stamp">镇群<br>之屎</span><div><span class="mono"><%= @representative.sid %></span><h2><%= link_to @representative.display_title,entry_path(@representative) %></h2><p>从这里出土，在 <%= @representative.natural_group_count %> 个群自然出现过。</p></div><%= link_to '打开代表作 →',entry_path(@representative),class:'button button-ghost' %></section><% end %><section class="section"><div class="section-heading"><h2>本群最近出土</h2><%= link_to '全部出土 ↗',entries_path(group:@group.slug) %></div><div class="shelf-grid"><%= render partial:'shared/entry_card',collection:@recent,as: :entry %></div><%= empty_state if @recent.empty? %></section><div class="rank-columns section"><section><h2>本群经典</h2><% @classic.each do |entry| %><%= render 'shared/entry_row',entry:entry %><% end %><%= empty_state('还在等待经得起时间的作品。') if @classic.empty? %></section><section><h2>本群最爱复读</h2><% @repeated.each do |entry| %><%= render 'shared/entry_row',entry:entry,metric:"本群 #{@repeat_counts.fetch(entry.id,0)} 次自然搬运" %><% end %></section></div><div class="rank-columns section"><section><h2>从这里传得最远</h2><% @exported.each do |entry| %><%= render 'shared/entry_row',entry:entry %><% end %></section><section><h2>本群最近吃过</h2><% @consumed.each do |entry| %><%= render 'shared/entry_row',entry:entry %><% end %><%= empty_state('机器人还没有在这里上菜。') if @consumed.empty? %></section></div><div class="detail-lower section"><section><h2>群馆时间线</h2><%= render 'shared/timeline',events:@timeline,show_entry:true %></section><section><% if AppConfig.features.group_taste_profile %><h2>本群口味画像</h2><p class="muted">只看已经发生的反馈，不猜群友想法。</p><div class="taste-profile"><% {'positive_trials'=>'正向试吃反馈','negative_trials'=>'明确负向反馈','responsive_trials'=>'产生反馈的试吃','classic_discoveries'=>'发现的典藏'}.each do |key,label| %><div><span><%= label %></span><b class="mono"><%= @stats.fetch(key,0) %></b></div><% end %></div><% end %><% if @contributors %><h2>本群搬运者</h2><% @contributors.each do |person| %><div class="person-row"><span class="person-initial"><%= person.display_name.first %></span><div><%= link_to person.display_name,transporter_path(person) %><small><%= person.title %></small></div></div><% end %><% else %><div class="privacy-note">本群选择了隐藏成员昵称。</div><% end %></section></div><% else %><div class="privacy-note large-note"><h2>这座群馆只公开统计。</h2><p>群友选择把具体藏品和成员留在群里。你仍然可以看看这座馆的出土与试吃记录数。</p></div><% end %>
