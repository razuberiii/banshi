<a class="group-card" href="<%= group_path(group) %>"><span class="group-sigil"><%= group.display_name.first %></span><div><h3><%= group.display_name %></h3><p><%= group.visibility=='statistics' ? '只公开统计的群馆' : truncate(group.description.to_s,length:35) %></p><span><%= group.stats.fetch('discoveries',group.discovered_entries.count) %> 件出土 · <%= museum_date(group.joined_at) %> 入网</span></div><b>↗</b></a>
