<% content_for :title,'管理本群' %><div class="breadcrumbs"><%= link_to @group.display_name,group_path(@group) %><span>/</span><span>管理本群</span></div><section class="opening"><div><h1>调一调，本群的胃口</h1><p>这里只改变本群偏好，平台安全限制始终生效。</p></div></section><%= form_with model:@group,url:group_path(@group),class:'management-form' do |f| %><%= render 'shared/errors',record:@group %><section class="form-section"><div><h2>本群怎么吃</h2><p>机器人名片是快速模式入口；高级开关可以单独覆盖采集或投放。</p></div><div class="form-fields"><label>机器人模式<%= f.select :mode,AppConfig.modes.rules.keys %></label><div class="field-pair"><label>内容采集<%= f.select :collect_enabled,[['跟随名片模式',''],['开启',true],['关闭',false]] %></label><label>主动传播<%= f.select :distribute_enabled,[['跟随名片模式',''],['开启',true],['关闭',false]] %></label></div><label>抢先试吃<%= f.select :trial_preference,[['积极参加 · 优先选我','OPT_IN'],['偶尔可以 · 有空补位','FALLBACK'],['不参加 · 永远不抽中','OPT_OUT']] %></label><div class="field-pair"><label>每日摄入上限<%= f.number_field :daily_limit,min:0,placeholder:AppConfig.distribution.daily_limit %><small>留空使用平台默认；0 表示不投放。</small></label><label>两次摄入的间隔（分钟）<%= f.number_field :cooldown_minutes,min:0,placeholder:AppConfig.distribution.cooldown/60 %></label></div><label class="check-label"><%= f.check_box :accept_hot %>接受当前热门</label><label class="check-label"><%= f.check_box :accept_classic %>接受典藏内容</label><label class="check-label"><%= f.check_box :accept_archaeology %>允许机器人主动考古</label></div></section><section class="form-section"><div><h2>敏感标签</h2><p>GREEN 正常匹配。YELLOW 只有所有标签都被接受才会投放。RED 永不自动传播。</p></div><div class="form-fields tag-checks"><%= hidden_field_tag 'group[accepted_tags][]','' %><% AppConfig.safety.tags.each do |key| %><label class="check-label"><%= check_box_tag 'group[accepted_tags][]',key,@group.accepted_tags.include?(key),disabled:AppConfig.safety.hard_block_tags.include?(key) %><%= tag_name(key) %><small><%= '平台禁止自动传播' if AppConfig.safety.hard_block_tags.include?(key) %></small></label><% end %></div></section><section class="form-section"><div><h2>这座群馆的门</h2><p>群号不会出现在公开页面。选择统计模式后，本站不展出本群来源的内容。</p></div><div class="form-fields"><label>公开名称<%= f.text_field :public_name,maxlength:60 %></label><label>群馆介绍<%= f.text_area :description,rows:3,maxlength:300 %></label><label>公开程度<%= f.select :visibility,[['公开群馆与馆藏','public'],['仅公开统计','statistics'],['完全隐藏群馆','hidden']] %></label><label class="check-label"><%= f.check_box :anonymous %>使用匿名名称（<%= @group.anonymous_name %>）</label><label class="check-label"><%= f.check_box :hide_members %>隐藏成员昵称与个人链接</label></div></section><div class="form-actions"><%= f.submit '保存本群胃口',class:'button' %><%= link_to '返回群馆',group_path(@group),class:'button button-ghost' %></div><% end %>
