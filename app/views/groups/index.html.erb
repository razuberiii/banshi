<% content_for :title,'群馆名录' %><section class="opening"><div><h1>每个群，都有自己的抽象史</h1><p>这里是 <%= @total %> 座群聊文化档案馆。群号和真实身份不公开。</p></div><%= link_to '认领我的群馆 →',claims_path,class:'button' %></section><%= form_with url:groups_path,method: :get,class:'catalog-search' do |f| %><%= f.search_field :q,value:params[:q],placeholder:'按公开名称找一座群馆',aria:{label:'搜索群馆'} %><%= f.submit '找群馆',class:'button' %><% end %><div class="group-grid group-grid-list"><% @groups.each do |group| %><%= render 'card',group:group %><% end %></div><%= empty_state if @groups.empty? %><%= render 'shared/pagination',total:@total,page:@page,size:24 %>
