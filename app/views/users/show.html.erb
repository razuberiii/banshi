<% content_for :title,@user.display_name %><section class="group-heading"><span class="person-initial large"><%= @user.display_name.first %></span><div><h1><%= @user.display_name %>的入馆证</h1><p><%= museum_date(@user.created_at) %> 开始逛馆 · 网站身份与 QQ 身份分开</p></div><%= button_to '离馆',logout_path,method: :delete,class:'button button-ghost' if @own %></section><% if @own %><div class="section-heading"><h2>我认领的群馆</h2><%= link_to '认领一个群 →',claims_path %></div><div class="group-grid"><% @groups.each do |group| %><%= render 'groups/card',group:group %><% end %></div><%= empty_state('还没有认领群馆。群主或管理员可以通过机器人验证。') if @groups.empty? %><section class="section"><h2>我的私人收藏夹</h2><div class="shelf-grid"><%= render partial:'shared/entry_card',collection:@favorites,as: :entry %></div><%= empty_state('逛到喜欢的藏品时，点一下收藏。') if @favorites.empty? %></section><section class="section"><h2>我的举报回执</h2><% Report.where(user:@user).includes(:shit_entry).order(created_at: :desc).limit(20).each do |report| %><div class="result-row"><span><%= report.shit_entry.sid %> · <%= Report::REASONS[report.reason] %></span><span><%= {'open'=>'等待处理','resolved'=>'已处理','dismissed'=>'已驳回'}.fetch(report.status) %></span><p><%= report.resolution %></p></div><% end %></section><% else %><div class="privacy-note">收藏夹、认领记录和举报回执只对本人开放。</div><% end %>
