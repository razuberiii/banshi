<% content_for :title,'领取入馆证' %><div class="narrow-page"><h1>领一张入馆证</h1><p class="muted">不需要 QQ 号。一个邮箱，一个你想使用的名字。</p><%= render 'shared/errors',record:@user %><%= form_with model:@user,url:signup_path,class:'stack-form' do |f| %><label>展示名<%= f.text_field :display_name,required:true,maxlength:40,autocomplete:'nickname' %></label><label>邮箱<%= f.email_field :email,required:true,autocomplete:'username' %></label><label>密码（至少 12 个字符）<%= f.password_field :password,required:true,minlength:12,autocomplete:'new-password' %></label><label>再次输入密码<%= f.password_field :password_confirmation,required:true,autocomplete:'new-password' %></label><%= f.submit '办证并入馆',class:'button' %><% end %><p><%= link_to '已经有证？去登录',login_path %></p></div>
